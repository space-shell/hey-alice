# Partition backups: images stay local (multi-GB, private); the manifest and
# verification marker are committed as the durable record of the backup.
.backups/**
!.backups/nx1-*/
!.backups/nx1-*/MANIFEST.sha256
!.backups/nx1-*/VERIFIED
!.backups/nx1-*/VERIFY-STATUS.md
!.backups/nx1-*/SUPER-TIEBREAK.txt
!.backups/nx1-*/VOLATILE-HASHES.txt

# Device capture logs (raw getevent etc.) — the keycode contract lives in
# docs/plan.md, not in raw logs.
logs/

# Gradle / Android build outputs
.gradle/
build/
app/build/
overlay/build/

# Gateway python venv
.venv/
gateway/.venv/

# Gateway local test audio (regenerable STT inputs / TTS outputs)
gateway/*.wav

# Nix build outputs
result
result-*
